 have hbad : ∀ r < Q, ∃ i, i < (badOf (cov.getD r [])).length ∧
     (((badOf (cov.getD r [])).getD i (0, 0)).1 : ℝ) / SC ≤ g r ∧ g r ≤ (((badOf (cov.getD r [])).getD i (0, 0)).2 : ℝ) / SC ∧
