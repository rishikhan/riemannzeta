theorem winOk_all : Pyr.allBelow 16 winOk = true := by decide +kernel
theorem wfun_quarter_high {x : ℝ} (h0 : 1 / 4 ≤ x) (h1 : x ≤ 1 / 2) : (1 / 4 : ℝ) ≤ wfun x := by
