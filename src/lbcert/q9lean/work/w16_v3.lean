theorem line_le_ends {v d p a b c x : ℝ} (hx1 : a ≤ x) (hx2 : x ≤ b) (ha : v + d * (a - p) ≤ c)
   (hb : v + d * (b - p) ≤ c) : v + d * (x - p) ≤ c := by
