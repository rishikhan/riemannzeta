def pAM (s : ℝ) : ℝ := ∑ j ∈ Finset.range 16, (cAM (j + 1) : ℝ) * Real.cos (ωAM (j + 1) * s)
theorem vAM_eq (s : ℝ) : vAM s = Real.cos (Real.sqrt 2 * s) + pAM s := by
