 have h1 := Finset.single_le_sum (f := fun r => ((bs.getD r 0 : ℕ) : ℝ) * g r)
   (fun r hr => mul_nonneg (Nat.cast_nonneg _) (hg r (Finset.mem_range.mp hr))) (Finset.mem_range.mpr hr)
