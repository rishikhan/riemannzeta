   ∀ j : ℕ, 1 ≤ j → 2 * j ≠ c.k → x ≠ j := by
 have b := c.base_sound hc hx1 hx2
 intro j _ hj
 rcases Nat.lt_or_gt_of_ne hj with h | h
 · have := (c.sep hc j).1 h; linarith [b.xlo]
 · have := (c.sep hc j).2 h; linarith [b.xhi]
