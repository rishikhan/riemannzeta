   ((hhc.mul hpc).continuousOn).integrableOn_compact isCompact_Icc
 have hIh : MeasureTheory.IntegrableOn h (Set.Icc (-(L/2)) (L/2)) :=
   (hhc.continuousOn).integrableOn_compact isCompact_Icc
