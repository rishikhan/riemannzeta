theorem sumR_eq (L : List ℕ) (i : ℕ) : ∀ n, ((sumR L i n : ℕ) : ℝ) = ∑ r ∈ Finset.Ico i (i + n), ((L.getD r 0 : ℕ) : ℝ)
 | 0 => by simp [sumR]
