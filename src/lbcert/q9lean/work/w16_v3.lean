   have hSC : (AMW.G.SC : ℝ) = 32768 := by norm_num [AMW.G.SC]
   by_cases hx : x = 1 / 2
   · exact ⟨15, by norm_num, by rw [hSC, hx]; norm_num, by rw [hSC, hx]; norm_num⟩
   · have hlt : x < 1 / 2 := lt_of_le_of_ne h1 hx
