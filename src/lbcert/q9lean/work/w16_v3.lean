       · have hu1 : u ∈ Set.Icc (-(L/2)) (-(L/2) + w) := by
           refine ⟨hu.1, ?_⟩
           have habs : |u| = -u := abs_of_nonpos hneg
           rw [habs] at hedge
           linarith
         have := hind0 (Set.Icc (L/2 - w) (L/2)) u
