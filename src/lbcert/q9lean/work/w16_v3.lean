     have hhalf : ((SC / 2 : ℕ) : ℝ) / SC = 1 / 2 := by norm_num [SC]
     have h19 := wfun_window (g r) (hg r hr) (by rw [hhalf] at hw; exact hw)
     have hq := (Nat.cast_le (α := ℝ)).mpr (hwin r hr); push_cast at hq
     have h1 : (cN : ℝ) ≤ (tA TS (adj r) : ℝ) * wfun (g r) := by
