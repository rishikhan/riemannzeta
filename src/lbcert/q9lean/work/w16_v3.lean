   have ih := sumR_eq L i (n + 1)
   rw [show i + (n + 2) = (i + (n + 1)) + 1 by omega, Finset.sum_Ico_succ_top (by omega), ← ih]
   simp only [sumR, Nat.add_eq]; push_cast; rw [Nat.add_assoc i n 1]
