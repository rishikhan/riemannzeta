theorem phiW_even (u : ℝ) : phiW ϱ L w (-u) = phiW ϱ L w u := by
 rw [phiW_eq_mul, phiW_eq_mul, fW_even, Taper.phi_even]
theorem phiW_nonneg (hϱ : TaperProfile ϱ) (u : ℝ) : 0 ≤ phiW ϱ L w u :=
