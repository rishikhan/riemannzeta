 unfold Fg
 have h1 := Finset.single_le_sum (f := fun n => ((tA TS n : ℕ) : ℝ) * wfun (gsum g (tI TS n) (tJ TS n)))
   (fun n _ => mul_nonneg (Nat.cast_nonneg _) (wfun_nonneg _)) (Finset.mem_range.mpr hn)
